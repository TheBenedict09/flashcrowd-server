[Unit]
Description=FLASHCROWD page-view backfill (10 Oct -> 24 Oct 12:00 UTC)
After=network-online.target
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/flashcrowd-server
EnvironmentFile=/home/ubuntu/flashcrowd-server/.env
Environment=FC_DATA=/home/ubuntu/data
ExecStart=/usr/bin/flock /home/ubuntu/data/pageviews.lock /home/ubuntu/venv/bin/python -W ignore pipeline/pageviews_loader.py --start 2026-10-10T00 --end 2026-10-24T12 --workers 2

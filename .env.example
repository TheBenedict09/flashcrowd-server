# Snowflake
SNOWFLAKE_ACCOUNT=xxxxx-yyyyy
SNOWFLAKE_USER=FC_APP
# key-pair auth; the key file is gitignored (no inline comments: systemd keeps them)
SNOWFLAKE_PRIVATE_KEY_PATH=secrets/fc_app_rsa_key.p8
SNOWFLAKE_ROLE=FC_ROLE
SNOWFLAKE_WAREHOUSE=FC_WH
SNOWFLAKE_DATABASE=FLASHCROWD
SNOWFLAKE_SCHEMA=CORE
# AWS (IAM user flashcrowd-pc1)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=eu-west-2
# ElevenLabs (TTS proxy; key stays server-side)
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...
ELEVENLABS_AGENT_ID=...
# Wikimedia (required, or you may be blocked)
WIKI_USER_AGENT=FlashcrowdOxHack/1.0 (your-team-email@example.com)
# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173
